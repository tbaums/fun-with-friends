#!/usr/bin/env bash
# fwf — fun-with-friends: a repo-agnostic multi-agent Claude Code dev swarm.
#
# Point it at a git repo and it stands up a 10-pane tmux factory across two
# sessions — coordination (PM · GV · CAPTAIN) and implementation (3 impl/QA
# pairs + a conductor) — that runs an ideas -> ship pipeline.
#
#   fwf start https://github.com/you/repo     # clone, detect, scaffold, launch
#   fwf attach                                # watch coordination (talk to the captain)
#   fwf stop                                  # graceful halt
#
# Run `fwf help` for the full subcommand list.
set -euo pipefail

# Resolve the real install dir, following symlinks — `install.sh` symlinks `fwf`
# into a bin dir, so BASH_SOURCE is the symlink, not the repo file. (Portable;
# macOS readlink lacks a reliable -f.)
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src";; esac
done
FWF_DIR="$(cd -P "$(dirname "$_src")" && pwd)"
unset _src _dir

# Base config (workspace paths, run dir) + detection, without requiring a
# profile to exist yet — `fwf init` runs before any profile is written.
source "$FWF_DIR/config.sh"
source "$FWF_DIR/lib/detect.sh"
source "$FWF_DIR/lib/profile.sh"
source "$FWF_DIR/lib/version_check.sh"

usage() {
  cat <<'EOF'
fwf — fun-with-friends multi-agent dev swarm

USAGE
  fwf [--profile NAME] <command> [args]

GETTING STARTED
  suggest <description>  Describe what you're trying to do; get a factory
                         design back — prebuilt or custom template, sizing,
                         and per-role model picks (works before any profile).
  start <url|path> [--name N] [--yes] [--build]
                         Clone (or use a local path), detect the toolchain,
                         scaffold a profile, provision worktrees, and launch.
                         Pauses to show the detected commands unless --yes.
  init  <url|path> [--name N] [--yes]
                         Same, but stop after scaffolding the profile
                         (clone + detect + write profiles/<name>.sh).

RUN THE FACTORY  (use --profile NAME, or it picks the only profile present)
  provision [--build]    Create worktrees + dev data (one-time per repo).
  up [--build-only|--pm-only|--floor-only|--coord-only]
                         Launch both tmux sessions and deliver prompts.
                         --build-only: (re)create just the build session,
                         around a LIVE captain pane (requires an existing
                         coordination session). --pm-only: (re)create just
                         the PM pane (GV, which never idles, is left alone;
                         also requires an existing coordination session).
                         --floor-only: both together (back-compat alias).
                         --coord-only: bring up the coordination session
                         (PM/GV/Captain) from a cold/fully-down state,
                         leaving any build floor (up, down, or absent)
                         completely untouched; a no-op if coordination is
                         already up. See "PER-PLANE IDLING" below (#105).
  attach [coord|build]   tmux attach to coordination (default) or implementation.
  dash                   Read-only status board (Rust + ratatui TUI): roles,
                         pipeline, prod, and the human-gated decision list.
                         Derived-first, so it works with the factory parked.
                         Downloads a prebuilt binary on first run (needs jq;
                         cargo only as an offline/unsupported-platform fallback).
                         No built-in remote view (issue #206) -- for a factory
                         running on another host, `ssh -t <host> fwf dash`
                         runs it there and streams the TUI back over ssh.
                         Anything else (a local dash pointed at a remote
                         profile/state dir) can't tell "no factory here" from
                         "everything is down" and renders UNKNOWN, not a
                         false DOWN.
  captain [--print]      Copy the CAPTAIN prompt to the clipboard (or --print it).
  respawn <role>         Hot-swap one pane:
                         implN | qaN | conductor | pm | gv | captain.

SIZING + MODELS + TEMPLATE  (accepted by start/provision/up/respawn/resume/down)
  --template NAME        Factory design template — the role-prompt set the
                         agents run (see 'fwf templates'; default: dev).
  --issues gh|local      Issue-tracker backend (alias: --local-issues).
                         local = markdown store under ~/.fun-with-friends/
                         issues/<profile>, OUTSIDE the repo — for repos whose
                         GitHub issues/labels you don't control. PRs still go
                         to GitHub; refs become LI-N; persist via FWF_ISSUES.
  --pairs N              Number of implementer/QA pairs (default 3).
  --model M              Model for every agent (claude --model M).
  --impl-model M | --qa-model M | --pm-model M | --gv-model M
  --captain-model M | --conductor-model M
                         Per-role model override (beats --model for that role).
                         Persist any of these in a profile via FWF_PAIRS /
                         FWF_MODEL / FWF_MODEL_<ROLE>.
  --budget-usd N         RECOMMENDED hard budget ceiling, in estimated dollars
                         (issue #108); unset = unlimited (default, opt-in).
                         Enforced against the same per-model price table
                         'fwf usage' shows — which already prices cache-read
                         at its true (10x-50x cheaper) rate, so a $ ceiling is
                         a correctly cache-read-weighted budget with no unit
                         guesswork. Enforced as a DELTA since this run's
                         'fwf up' (a run-start baseline is snapshotted when
                         armed), not the lifetime total in the transcripts —
                         reusing worktree paths from an earlier run won't
                         inherit its spend. Mutually exclusive with
                         --token-budget (setting both is an error).
  --token-budget N       Hard ceiling in RAW tokens across all roles combined
                         (issue #96), back-compat; unset = unlimited. Counts
                         cache-read tokens, which dominate real runs by 2-3
                         orders of magnitude — prefer --budget-usd unless you
                         specifically want a raw-token ceiling. Also enforced
                         as a this-run delta (see --budget-usd).
                         Either ceiling is armed by 'fwf up' (or
                         'up --floor-only'/a floor bounce, which preserve the
                         existing run's baseline): a background WRITER pauses
                         every role (BUDGET_HOLD) once this-run spend reaches
                         the ceiling — within one FWF_BUDGET_CHECK_INTERVAL
                         poll (default 60s) of crossing it, not instantly, so
                         set the cap with some headroom. Fail-closed (pauses,
                         never silently permits) if usage or the run-start
                         baseline can't be read, or if a seat's model isn't in
                         the price table yet (only matters for --budget-usd).
                         See 'fwf usage' for this-run vs cumulative spend +
                         ARMED/NOT ARMED status, and 'fwf usage --clear-hold'
                         to lift a hold.
  --session-pct PARK[/RESUME] | --weekly-pct PARK[/RESUME]
                         (issue #149) Park the floor (BUDGET_HOLD) when the
                         Claude subscription's OWN usage meters — the rolling
                         5h session window / the weekly allowance — cross
                         PARK%, distinct from --budget-usd/--token-budget
                         (which are blind to subscription limits). fwf does
                         NOT read these meters itself: an operator-run helper
                         writes a small structured signal (never OCR — see
                         docs/subscription-budget.md) that the same WRITER
                         polls. Unset = not armed (default). RESUME defaults
                         to PARK minus a hysteresis gap
                         (FWF_SUBSCRIPTION_RESUME_GAP, default 15 points) when
                         omitted; resume only happens on a FRESH sub-RESUME
                         reading, never on elapsed time alone. A missing,
                         stale (older than FWF_SUBSCRIPTION_STALE_SECS,
                         default 900s), or malformed signal fails CLOSED
                         (parks) exactly like an unreadable token/$ read
                         above — this brake is opt-in per-flag but never
                         opt-in on blindness once armed.
  issues <cmd> [...]     The LOCAL issue tracker (--issues local): a gh-shaped
                         CLI (create/list/view/edit/comment/close/reopen/export) over
                         a markdown store outside any repo. 'fwf issues help'.
  stop                   Graceful halt: agents commit WIP and idle.
  resume [--clear-only]  Clear the stop sentinel and re-arm all roles (or just clear).
  down [--purge|--build-only|--pm-only|--floor-only [--actor NAME] [--reason TEXT] [--force]]
                         Kill tmux sessions/panes (--purge also removes worktrees).
                         --build-only kills only the build session; --pm-only
                         kills only the PM pane; --floor-only is both together
                         (back-compat alias) — captain and GV always survive,
                         and each unit logs why ('fwf dash' shows IDLE, not
                         crashed). Each unit refuses within its own
                         FWF_BUILD_COOLDOWN / FWF_PM_COOLDOWN seconds (default
                         300 each) of its own last up unless --force is passed
                         — the deterministic anti-thrash bound (#88). Each unit
                         ALSO refuses — NOT overridable by --force — while
                         idling it could strand work: --build-only while any PR
                         is open, a promotion is in flight, or a ticket is
                         CLAIMED but not yet pushed as a PR and that claimant's
                         pane is alive-or-unconfirmed (issue #147, sharing
                         'fwf supervise's #165 liveness signal); --pm-only
                         while any product-wip draft is open (issue #105).

PER-PLANE IDLING (issue #105)
  The captain idles the build floor and the PM pane INDEPENDENTLY, driven by
  each unit's own workload — GV never idles in v1 (must stay reachable to the
  captain on demand; no down-path ever tears it down). See 'up'/'down' above
  for the --build-only/--pm-only/--floor-only flags, and the README's
  "Floor lifecycle" section for the full design.

UTILITIES
  pr-review-state <pr>   Print the authoritative qa<->impl review state for a
                         PR on a shared-account swarm (CHANGES_REQUESTED
                         <branch|none> | AWAITING_REVIEW | APPROVED | NONE) —
                         see docs/shared-account.md.
  pr-reviewer <pr>       Print the CURRENTLY ASSIGNED reviewer for a PR from
                         its recorded `fwf-Reviewer:` marker (issue #194) —
                         <seat> | none (explicit zero-QA-seats case) |
                         NO_MARKER (pre-migration/human PR, caller applies
                         the branch-prefix fallback) | UNKNOWN (the PR
                         itself could not be read — NEVER treated the same
                         as NO_MARKER, or a transient gh failure would
                         misroute an explicitly-assigned PR). Comment
                         markers beat the body marker; newest comment wins.
  pr-assign-reviewer <head-branch>
                         Decide who a NEW PR's reviewer should be (issue
                         #194): implN/* -> qaN (today's pairing, unchanged);
                         otherwise the least-loaded CONFIGURED QA seat by
                         open-assigned-PR count, ties broken by lowest seat
                         index. Deliberately liveness-blind (a briefly-down
                         seat still gets routed to — see fwf-pr-
                         assign-reviewer.sh); zero configured QA seats ->
                         `none`. Run at PR-creation time; the result is
                         recorded as an `fwf-Reviewer:` marker, never
                         recomputed on every survey.
  branch-policy check [<branch>]
                         Diff LIVE GitHub branch-protection settings against
                         the committed .github/branch-policy.json (issue
                         #220) — required status-check contexts, `strict`,
                         `enforce_admins`. Prints one violation line per
                         mismatch (an unprotected branch is itself a
                         violation); empty output means fully compliant.
                         NEVER mutates anything — read-only. Checks every
                         policy branch if none is named.
  branch-policy producible
                         Assert every required context in the policy is
                         actually emitted by a CI job that runs on every
                         PR — catches a silently-renamed job or an
                         on.paths-filtered job before either blocks every
                         merge forever with no failing check to point at.
  pr-checks-honored <n>  The QA-side ERGONOMIC pre-merge checkpoint (issue
                         #220) — NOT the security control (branch protection
                         is); every seat can still merge past this with raw
                         gh. Reads the PR's actual check conclusions: any
                         FAILURE refuses (prints "REFUSED: <check-name>")
                         UNLESS a plain PR comment's first line names it
                         exactly (`fwf-CI-discount: <check-name>`) — naming
                         one flaky check never licenses advancing past a
                         DIFFERENT, deterministic red one. Exit 0 = honored;
                         1 = refused (names which); 2 = checks/comments
                         unreadable, fails closed, never silently honored.
  pr-context --issue <n> [n...] | --pr <num> | <n> [n...]
                         Print the sanitized "## Context & rationale" fold for
                         the given issue number(s) — an implementer/QA agent
                         runs this for real when composing a PR/squash-merge
                         body (issue #106); fails closed (prints nothing, rc 1)
                         if fwf-internal vocabulary survives sanitization.
                         --issue <n> folds the given issue(s) directly; --pr
                         <num> resolves that PR's own linked issue ("Closes
                         #n" in its body) and folds THAT — pass the PR number
                         you already have, get the right card (issue #189).
                         The bare <n> form still works for a genuine issue
                         number but refuses loudly if <n> resolves to a PR.
  merge <num> [--target BRANCH]
                         Squash-merge PR <num> with the crafted history card
                         (context + credit + fwf-Provenance) ALWAYS included
                         (issue #136) — the one code path every merge should
                         use instead of hand-composing the body inline, since
                         prose an agent transcribes is exactly what shipped
                         #189's bug 16 times. Refuses (merges nothing) if the
                         context fold itself refuses (issue #106 guard) or
                         the PR has no resolvable linked issue.
  backfill-context [--to REF] [--force] [--push] [--dry-run]
                         Recover hollow history cards WITHOUT rewriting any
                         commit (issue #212, the one-shot recovery for what
                         #136's go-forward guard deliberately never audits):
                         finds every commit whose card is entirely
                         "_(none logged)_" while its linked issue genuinely
                         has content, regenerates the card with the fixed
                         extractor, and attaches it as a git note under
                         refs/notes/fwf-context (never refs/notes/commits).
                         Idempotent — a commit that already has a note is
                         left alone unless --force. Notes are LOCAL ONLY
                         unless --push. Every backfilled note states it was
                         RECONSTRUCTED and as of what date, since it is a
                         reconstruction from whatever the linked issue says
                         NOW, not a contemporaneous record of what it said
                         at merge time.
  flag-captain <n> --role R --reason TEXT
                         Raise a "needs-captain" flag on issue/PR <n> (label +
                         a NEEDS-CAPTAIN: [R] TEXT comment) — any role calls
                         this when something needs the captain's decision; the
                         captain's per-tick sweep picks it up reliably instead
                         of depending on a pane message (issue #113). Same
                         command in gh-issues and local-issues mode.
  flag-captain <n> --clear [--note TEXT]
                         Clear a flag once handled (removes the label; TEXT
                         records what you did in an optional comment).
  flag-captain sweep     List every open needs-captain flag: # · [role] ·
                         reason · age — see docs/needs-captain.md.
  usage [--clear-hold|--clear-unknown-log]
                         Per-role token usage + an estimated $ equivalent,
                         read from each role's own Claude Code session
                         transcripts, plus budget-enforcement status
                         (ARMED/NOT ARMED + current hold, issue #96; see
                         dash's Usage tab too). --clear-hold lifts a
                         BUDGET_HOLD by hand (the writer re-writes it next
                         tick if still over budget). Also reports
                         collapsing-read diagnostics (issue #211): a LIVE
                         PROBE of every role's tick read right now, plus
                         RECENT UNKNOWNS from a bounded log every converted
                         reader appends to on failure (lib.sh's
                         fwf_log_unknown_read) -- a transient failure is
                         often over by the time anyone checks, so the live
                         probe alone isn't enough. --clear-unknown-log
                         clears that log.
  gate <role> [--e2e] -- <cmd...>
                         The shared guarded gate/e2e launcher (issue #123):
                         every role prompt's __GATE__/__E2E__ placeholder
                         renders through this. Skips (exit 75) rather than
                         stacking a second run when <role>'s own prior gate
                         is still in flight; --e2e additionally takes the
                         floor-wide e2e lock (issue #65) for a harness that
                         shares fixed ports across roles. The wrapped
                         command never outlives the lock (issue #195): a
                         backgrounded server is torn down before the lock
                         releases (FWF_GATE_TEARDOWN_GRACE_SECS, default
                         5s, bounds the graceful TERM-then-KILL window), a
                         dead holder's orphaned server is reaped on the
                         next acquire, and a foreign port occupant on
                         failure is diagnosed by PID/command, never killed.
                         Every terminal run also writes a SHA-keyed verdict
                         record (issue #220), now carrying a fingerprint of
                         what actually ran (issue #237) -- see `gate-promote`
                         below, the obliged call site that reads it.
                         FWF_GATE_CANARY_MARKER (issue #237 AC k, opt-in):
                         a substring identifying a deliberately-failing
                         sentinel case (requires GATE_CASE_EXTRACTOR too) --
                         if that case does not come back FAIL, the suite has
                         no confirmed path to red and the recorded verdict
                         is downgraded to `unknown` rather than a pass, so a
                         harness that has silently stopped being able to
                         fail (the #242 shape) cannot write a confident
                         green.
  gate-promote <role> <target-branch>
                         The OBLIGED call site binding a promote to the
                         verdict that authorizes it (issue #237) -- replaces
                         a raw `git merge && git push` an agent was trusted
                         to gate correctly by its own prose reasoning. Reads
                         <role>'s last recorded gate-tip verdict; refuses
                         (exit 1, naming why) unless it is exactly `green`,
                         its SHA still resolves, and its gate_fingerprint
                         (if any) is not on the revocation list
                         ($FWF_STATE_DIR/gate-revoked-fingerprints). On
                         success, merges that EXACT SHA as a literal hash
                         (never a re-resolved ref) into <target-branch> and
                         pushes, as ONE operation -- the check and the push
                         are never separable in a caller's prompt.
  gate-revoke <fingerprint> [reason]
                         List <fingerprint> at
                         $FWF_STATE_DIR/gate-revoked-fingerprints (issue
                         #237 AC k2) -- every subsequent `gate-promote`
                         refuses any green record carrying it. Idempotent.
                         Populating this list is a governance decision
                         (a human or the captain, after an investigation)
                         this command does not make on its own.
  gate-rust-scope --against BRANCH [--safe GLOB]... [--log FILE]
                    [--full-suite-secs N]
                         SHADOW classifier for whether a profile's Rust suite
                         COULD be skipped for the current branch's diff
                         (issue #138, piece B) — never skips anything itself;
                         always prints "Rust suite WOULD SKIP/RUN ..." and
                         logs the verdict for the future keep-or-drop-B
                         measurement. FWF_GATE_FULL=1 forces RUN regardless of
                         the diff (kill switch, plumbed ahead of the flip).
  authz <issue>          Verify HUMAN authorization to build/un-gate <issue>
                         (issue #150): AUTHORIZED (exit 0) iff the operator
                         un-gate signal — a comment emitted only by a human
                         `fwf dash` approve keypress — is in the thread; else
                         HELD (exit 10). NOT-GATED (exit 12, issue #215) when
                         the issue never carried the gate label at all — there
                         is nothing to un-gate, but this is NOT the same as
                         AUTHORIZED. Fails closed to INDETERMINATE (exit 2)
                         if unreadable. The checkable answer to "was this
                         approved?" — never infer it from label state or pane
                         text. Read-only.
  claim <issue>          A fail-FAST authorization checkpoint at intent-
                         formation time (issue #243) — NOT a security
                         control (that's #207's repository-side merge
                         refusal; this can simply be skipped). Runs `fwf
                         authz` first: HELD/INVALID refuses (exit 1, names
                         the cause as "policy"); INDETERMINATE warns
                         ("infrastructure" cause) and still proceeds
                         (claiming is cheap/reversible — refusing on a mere
                         read failure is what manufactures a stall);
                         AUTHORIZED/NOT-GATED proceed. Also scans the issue
                         body for a declared `## HARD PREREQUISITE` heading
                         and warns (never refuses) on any prerequisite that
                         isn't itself AUTHORIZED/NOT-GATED yet — absent, not
                         "no prerequisites exist": the scan is a heading
                         match, not a schema, and says so. On success,
                         creates the claim artifact — an empty commit
                         `claim #<n>: <title>` — and nothing else (no
                         branch switch/create; issue #177). Refusals are
                         logged durably for `fwf dash` to surface as a
                         count, never recomputed per render.
  auth resolve           Re-resolve the claude auth credential (issue #217)
                         and print its source (env|credentials_file|
                         keychain), without launching anything — `fwf up`
                         already does this on every launch; use this to
                         check what it WOULD resolve to right now.
  auth clear             Remove the persisted auth sink
                         (~/.fun-with-friends/auth.env) by hand. `fwf down`'s
                         full teardown already does this; idempotent.
  reconcile [--check] [--branch NAME ...] [--against BRANCH]
                         Classify staging/integration against main (BEHIND ->
                         fast-forward reconcile / AHEAD -> normal no-op /
                         DIVERGED -> loud human-only halt / SUSPECT -> fail
                         closed), issue #114. Called from the release runbook
                         (write path) AND the captain's per-tick stale-base
                         guard (read/safety-net path, before any assignment) —
                         one shared classifier for both. Exits non-zero iff
                         some branch is unsafe to build on right now.
  worktree-refresh <role>
                         Fetch-then-detach refresh for a READ-ONLY role's
                         worktree (PM/GV/Captain), issue #146 — a detached,
                         clean worktree is fetched + re-detached onto current
                         __DEFAULT__ every call; a worktree on a branch or
                         with uncommitted changes is left completely
                         untouched. Three-tier exit code, so "non-zero =
                         alarm" is structural, not a wording convention: 0
                         only for a confirmed-current REFRESHED; 1 for a hard
                         failure (STALE/FETCH_FAILED/NO_WORKTREE — a
                         read-only role with no worktree has nothing to read
                         from, the worst case, not a benign no-op); 2 for a
                         deliberate safety skip that still leaves the
                         worktree unrefreshed (SKIPPED_BRANCH/SKIPPED_DIRTY).
                         Never silently reads as success. impl/qa are out of
                         scope (their own safety rule already protects
                         mid-ticket work, but callers should only invoke
                         this for read-only roles). `fwf supervise`
                         independently re-runs this same refresh for pm/gv/
                         captain every pass and alarms WORKTREE_STALE /
                         WORKTREE_ANOMALY through its routed channel if a
                         role is still stale afterward — not dependent on
                         the role noticing on its own.
  eval --role R --models M1,M2 [--template T] [--scenario S] [--trials N]
       [--judge-model M]
                         Role-level model eval: render the role's production
                         prompt, run scenario fixtures through each model, and
                         LLM-judge the responses against per-scenario rubrics
                         (see docs/eval-harness.md).
  shell [--rebuild]      Build the fwf toolchain container image and drop into
                         it with this repo + your host claude/gh auth mounted
                         (a reproducible Linux sandbox — see docs/containers.md).
  doctor                 Check tmux / git / gh / claude and report versions.
  upgrade [--check]      Upgrade this fwf install to the latest release —
                         git-clone installs fetch tags + ff-merge to the release
                         tag; tarball installs download the release and re-link.
                         --check only reports.
  profiles               List available profiles.
  templates              List available factory design templates.
  version                Print the fwf version (aliases: -v, --version).
  help                   Show this help.
  reconcile-guard [--against BRANCH] [--branch NAME ...]
                         Run `reconcile` and give its verdict a CONSEQUENCE on
                         the untagged direct-to-main path (issue #179): on a
                         non-zero verdict, file ONE durable, self-closing
                         tracking issue and exit non-zero; on a clean verdict,
                         close that issue if it is open. Idempotent — a
                         divergence persisting across N pushes produces one
                         artifact, not N. Called from ci.yml's push-to-main job,
                         where a `::warning::` in a green run would be invisible.

ENVIRONMENT
  FWF_PROFILE            Profile to use (same as --profile).
  FWF_WORKSPACE_BASE     Where repos are cloned (default: ~/.fun-with-friends/workspaces).
  See config.sh for the full set of FWF_* knobs.
EOF
}

die() { echo "fwf: $*" >&2; exit 1; }

# Issue #149: parse --session-pct/--weekly-pct's PARK[/RESUME] syntax into
# FWF_<KIND>_PCT_PARK/_RESUME. RESUME, when omitted, defaults to PARK minus
# the configured hysteresis gap (never equal to PARK — see config.sh) so a
# reading sitting exactly on the line can't flap park/resume every poll.
_fwf_parse_pct_flag() { # $1 = session|weekly  $2 = "PARK" or "PARK/RESUME"
  local kind="$1" val="$2" park resume
  case "$val" in
    */*) park="${val%%/*}"; resume="${val#*/}" ;;
    *)   park="$val"; resume="" ;;
  esac
  [ -n "$park" ] || die "--${kind}-pct needs a PARK value (got '$val')"
  if [ -z "$resume" ]; then
    resume="$(awk -v p="$park" -v g="$FWF_SUBSCRIPTION_RESUME_GAP" 'BEGIN{r=p-g; if (r<0) r=0; print r}')"
  fi
  case "$kind" in
    session) export FWF_SESSION_PCT_PARK="$park" FWF_SESSION_PCT_RESUME="$resume" ;;
    weekly)  export FWF_WEEKLY_PCT_PARK="$park" FWF_WEEKLY_PCT_RESUME="$resume" ;;
  esac
}

# A linked git worktree has .git as a FILE ("gitdir: <repo>/.git/worktrees/<n>"),
# never a directory — unlike a plain clone (dir) or a tarball extract (absent).
# Pulling a worktree in place is unsafe (it may be on a feature branch,
# detached HEAD, or dirty), so `upgrade` must never treat one as a plain-clone
# pull. Detection is pure text parsing of the gitdir-file (no `git` call), so
# it still works when the worktree's linked repo can't be resolved.
#
# Echoes the worktree's main checkout root and returns 0 if $1/.git is a
# worktree gitdir-file whose target we can parse; returns 1 (nothing echoed)
# if $1/.git is a plain directory, absent, or an unrecognized gitdir-file shape.
fwf_worktree_main_root() {
  local dir="$1" link
  [ -f "$dir/.git" ] || return 1
  link="$(sed -n 's/^gitdir: *//p' "$dir/.git")"
  case "$link" in
    */.git/worktrees/*) echo "${link%/.git/worktrees/*}"; return 0;;
    *) return 1;;
  esac
}

# --- profile helpers --------------------------------------------------------
profiles_dir() { echo "$FWF_DIR/profiles"; }

list_profiles() { # bare names, one per line
  local f
  for f in "$(profiles_dir)"/*.sh; do
    [ -e "$f" ] || continue
    basename "$f" .sh
  done
}

# Resolve which profile to use: explicit FWF_PROFILE wins; else if exactly one
# profile exists, use it; else error and list the choices.
resolve_profile() {
  if [ -n "${FWF_PROFILE:-}" ]; then echo "$FWF_PROFILE"; return; fi
  local names count
  names="$(list_profiles)"
  count="$(printf '%s\n' "$names" | grep -c . || true)"
  if [ "$count" = "1" ]; then echo "$names"; return; fi
  if [ "$count" = "0" ]; then
    die "no profiles yet — run 'fwf init <git-url>' or 'fwf start <git-url>' first."
  fi
  echo "fwf: multiple profiles exist — pass --profile NAME (before OR after the command), or set FWF_PROFILE=NAME:" >&2
  printf '  %s\n' $names >&2
  exit 1
}

# --- context-derived profile resolution (issue #182) ------------------------
# `resolve_profile()` above trusts ambient $FWF_PROFILE unconditionally. That
# is fine for an explicit per-invocation --profile pin (engine() folds it into
# $FWF_PROFILE before calling resolve_profile), but a STATE-WRITING/liveness
# call like `tick` has no --profile flag at all — any $FWF_PROFILE it sees can
# only be leftover ambient env from an unrelated shell/profile, never a
# deliberate override. Confirmed live: a role's `fwf tick` heartbeat landing
# under the WRONG profile's state dir makes health-gate/respawn see it as
# DEAD while it is actively working, risking a destructive respawn that
# discards in-flight context. Do not reuse this for engine()-routed commands
# (up/gate/dash/...) — those DO support an explicit --profile override that
# must keep winning over context.
#
# A worktree `fwf-provision.sh` creates carries a `.fwf-profile` marker (at
# its root) naming the profile it was provisioned for — written once, by the
# process that resolved the profile correctly at creation time. That marker
# is a stronger signal than ambient env for "which profile is THIS role's
# heartbeat for" because it can never be stale-leftover from an unrelated
# shell. Echoes the marker's profile name; returns 1 (nothing echoed) if this
# isn't a provisioned worktree/scratch dir, or its marker names an unknown
# profile.
fwf_context_profile() {
  local dir marker name
  dir="$(git rev-parse --show-toplevel 2>/dev/null)" || dir="$PWD"
  marker="$dir/.fwf-profile"
  [ -f "$marker" ] || return 1
  name="$(cat "$marker" 2>/dev/null)"
  [ -n "$name" ] || return 1
  [ -f "$(profiles_dir)/$name.sh" ] || return 1
  echo "$name"
}

# True (rc 0) if profile $1's state dir shows no liveness activity yet (no
# role has ever ticked under it) — a "phantom" profile dir, as opposed to one
# the running swarm actually writes to.
fwf_profile_ticks_phantom() {
  local d="$FWF_RUN/state/$1/tick"
  [ -d "$d" ] || return 0
  local f; for f in "$d"/*; do [ -e "$f" ] && return 1; done
  return 0
}

# True (rc 0) if some OTHER existing profile (not $1) has live tick activity.
# Used only to sharpen the phantom-profile alarm below — never fires on a
# fresh/cold-start profile that simply hasn't ticked yet, since that requires
# NO other profile to be live either.
fwf_other_profile_live() {
  local skip="$1" name
  while read -r name; do
    [ -n "$name" ] && [ "$name" != "$skip" ] || continue
    fwf_profile_ticks_phantom "$name" || return 0
  done <<< "$(list_profiles)"
  return 1
}

# Resolve the profile for a state-writing/liveness call (currently: `tick`).
# Priority, most to least trustworthy (issue #182):
#   1. PRIMARY   — this worktree's `.fwf-profile` marker (fwf_context_profile).
#                  Never trusts ambient env, so a stray FWF_PROFILE=wrong can't
#                  misroute the heartbeat. This is the real fix.
#   2. BACKSTOP  — no marker found (not a provisioned worktree/scratch dir):
#                  fall back to ambient/single-profile resolution, but if
#                  ambient is set to a profile with NO live activity while
#                  some OTHER profile demonstrably IS live, warn loudly — the
#                  swarm is running elsewhere and this heartbeat is likely
#                  about to land in a phantom dir. Warns only; tick must never
#                  hard-fail on a liveness call.
#   3. LAST RESORT — resolve_profile()'s existing behavior (today's ambient
#                  trust / single-profile default), unchanged.
resolve_profile_liveness() {
  local ctx amb
  if ctx="$(fwf_context_profile)"; then
    amb="${FWF_PROFILE:-}"
    if [ -n "$amb" ] && [ "$amb" != "$ctx" ]; then
      echo "fwf: WARNING ambient FWF_PROFILE=$amb does not match this worktree's provisioned profile '$ctx' (issue #182) — using '$ctx' (context-derived), not the ambient value, to avoid misrouting the heartbeat" >&2
    fi
    echo "$ctx"
    return 0
  fi
  amb="${FWF_PROFILE:-}"
  if [ -n "$amb" ] && fwf_profile_ticks_phantom "$amb" && fwf_other_profile_live "$amb"; then
    echo "fwf: WARNING ambient FWF_PROFILE=$amb has no live tick activity while another profile does — this heartbeat may be misrouting to a phantom profile dir (issue #182); no worktree marker found to confirm the correct profile" >&2
  fi
  resolve_profile
}

# Run an engine script with the resolved profile exported. Accepts a
# post-subcommand --profile/--profile=NAME (issue #69) for commands that
# don't otherwise take runtime flags (dash, issues, pr-review-state, stop);
# last --profile seen (pre- or post-subcommand) wins.
engine() { # $1 = script basename, rest = args
  local script="$1"; shift
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile)   [ $# -ge 2 ] || die "--profile needs a value"; export FWF_PROFILE="$2"; shift 2;;
      --profile=*) export FWF_PROFILE="${1#*=}"; shift;;
      *) args+=("$1"); shift;;
    esac
  done
  FWF_PROFILE="$(resolve_profile)" exec "$FWF_DIR/$script" ${args[@]+"${args[@]}"}
}

# Pull the runtime sizing/model flags out of an arg list, exporting the
# matching FWF_* vars; everything else lands in RUNTIME_ARGS for the engine
# script. Lets `fwf up --pairs 2 --impl-model sonnet` work with the flags in
# any position (issue #7).
RUNTIME_ARGS=()
parse_runtime_flags() {
  RUNTIME_ARGS=()
  local roleflag
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile)   [ $# -ge 2 ] || die "$1 needs a value"; export FWF_PROFILE="$2"; shift 2;;
      --profile=*) export FWF_PROFILE="${1#*=}"; shift;;
      # issue #190: FWF_PAIRS_REQUESTED distinguishes an EXPLICIT --pairs
      # from FWF_PAIRS's own default/profile value (lib.sh:250 defaults an
      # unset FWF_PAIRS to 3) -- fwf-up.sh needs this to know whether a live
      # floor's mismatch was a discarded operator request (fail loudly) or
      # just the ordinary "fwf up" no-op with no --pairs at all (unchanged).
      --pairs)   [ $# -ge 2 ] || die "$1 needs a value"; export FWF_PAIRS="$2"; export FWF_PAIRS_REQUESTED=1; shift 2;;
      --pairs=*) export FWF_PAIRS="${1#*=}"; export FWF_PAIRS_REQUESTED=1; shift;;
      --model)   [ $# -ge 2 ] || die "$1 needs a value"; export FWF_MODEL="$2"; shift 2;;
      --model=*) export FWF_MODEL="${1#*=}"; shift;;
      --template)   [ $# -ge 2 ] || die "$1 needs a value"; export FWF_TEMPLATE="$2"; shift 2;;
      --template=*) export FWF_TEMPLATE="${1#*=}"; shift;;
      --issues)   [ $# -ge 2 ] || die "$1 needs a value"; export FWF_ISSUES="$2"; shift 2;;
      --issues=*) export FWF_ISSUES="${1#*=}"; shift;;
      --local-issues) export FWF_ISSUES=local; shift;;
      --token-budget)   [ $# -ge 2 ] || die "$1 needs a value"; export FWF_TOKEN_BUDGET="$2"; shift 2;;
      --token-budget=*) export FWF_TOKEN_BUDGET="${1#*=}"; shift;;
      --budget-usd)   [ $# -ge 2 ] || die "$1 needs a value"; export FWF_BUDGET_USD="$2"; shift 2;;
      --budget-usd=*) export FWF_BUDGET_USD="${1#*=}"; shift;;
      --session-pct)   [ $# -ge 2 ] || die "$1 needs a value"; _fwf_parse_pct_flag session "$2"; shift 2;;
      --session-pct=*) _fwf_parse_pct_flag session "${1#*=}"; shift;;
      --weekly-pct)   [ $# -ge 2 ] || die "$1 needs a value"; _fwf_parse_pct_flag weekly "$2"; shift 2;;
      --weekly-pct=*) _fwf_parse_pct_flag weekly "${1#*=}"; shift;;
      --impl-model|--qa-model|--pm-model|--gv-model|--captain-model|--conductor-model)
        [ $# -ge 2 ] || die "$1 needs a value"
        roleflag="${1#--}"; roleflag="$(printf '%s' "${roleflag%-model}" | tr '[:lower:]' '[:upper:]')"
        export "FWF_MODEL_$roleflag=$2"; shift 2;;
      --impl-model=*|--qa-model=*|--pm-model=*|--gv-model=*|--captain-model=*|--conductor-model=*)
        roleflag="${1%%=*}"; roleflag="${roleflag#--}"; roleflag="$(printf '%s' "${roleflag%-model}" | tr '[:lower:]' '[:upper:]')"
        export "FWF_MODEL_$roleflag=${1#*=}"; shift;;
      *) RUNTIME_ARGS+=("$1"); shift;;
    esac
  done
}

# issue #188: resolution is otherwise invisible and gets debugged by reading
# source (the exact #30/#31 class of pain) -- report the ABSOLUTE file
# actually loaded and whether it was in-tree/explicit/auto-detected, plus any
# name the profile set that doctor dropped (not in the out-of-tree
# allowlist), so "why is my setting ignored?" is answerable in one command.
# Never fails doctor: a broken profile is exactly the kind of thing doctor
# exists to surface, so its own error is printed rather than swallowed.
_doctor_profile_resolution() {
  local out
  if ! out="$(FWF_PROFILE="${FWF_PROFILE:-$(resolve_profile 2>/dev/null || true)}" bash -c '
    source "'"$FWF_DIR"'/lib.sh" 2>&1
    printf "%s\t%s\t%s\t%s\n" "$PROFILE" "$FWF_PROFILE_RESOLUTION_MODE" "$PROFILE_FILE" "${FWF_PROFILE_DROPPED_NAMES:-}"
  ' 2>&1)"; then
    echo "  profile   : could not resolve — $out"
    return 0
  fi
  local line; line="$(printf '%s\n' "$out" | tail -1)"
  local name mode file dropped
  IFS=$'\t' read -r name mode file dropped <<<"$line"
  printf '  profile   : %s (%s) -> %s\n' "$name" "$mode" "$file"
  if [ -n "$dropped" ]; then
    echo "  profile   : WARNING — not exportable out-of-tree, ignored:$dropped"
  fi
}

# --- doctor -----------------------------------------------------------------
doctor() {
  local ok=0
  echo "fwf doctor"
  printf '  bash      : %s\n' "$BASH_VERSION"
  _doctor_one tmux   "tmux is required for the grid"            || ok=1
  _doctor_one git    "git is required (worktrees)"              || ok=1
  _doctor_one gh     "GitHub CLI is required (issues + PRs)"    || ok=1
  # the bare binary from a custom FWF_CLAUDE_CMD — NOT ${CLAUDE_CMD%% *}, which
  # is 'env' once config.sh/lib.sh prepend their PATH/env wrappers
  local claude_bin; claude_bin="${FWF_CLAUDE_BIN:-${CLAUDE_CMD%% *}}"
  _doctor_one "$claude_bin" "Claude Code CLI is required in each pane" || ok=1

  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then echo "  gh auth   : authenticated"; else
      echo "  gh auth   : NOT authenticated — run 'gh auth login'"; ok=1; fi
  fi
  printf '  workspace : %s\n' "$FWF_WORKSPACE_BASE"
  printf '  run dir   : %s\n' "$FWF_RUN"
  _doctor_profile_resolution
  fwf_doctor_version_line
  _doctor_usage_schema
  _doctor_e2e_cmd_check
  _doctor_api_budget_check
  [ "$ok" = 0 ] && echo "  -> all good." || echo "  -> fix the items above before launching."
  return "$ok"
}
# issue #239: surface GitHub API headroom where an operator already looks.
# "1,900 left" means nothing without the burn rate beside it -- reports
# remaining/limit, seconds to reset, and the CHARGED rate (200s only, never
# free TTL-hits/304s) over the last hour, so a reader can see whether
# anything is trending toward exhaustion. Both reads (headroom + metrics)
# are cached on fwf-ghcache.sh's own standard TTL -- doctor adds zero new
# per-run API calls of its own. Informational only, like the other
# doctor sub-checks above: never fails doctor, and degrades to an explicit
# UNKNOWN rather than a guessed number when the read itself can't complete.
_doctor_api_budget_check() {
  command -v gh >/dev/null 2>&1 || { echo "  api budget : skip (gh not installed)"; return 0; }
  local hr remaining limit reset now reset_in mret charged eta
  hr="$("$FWF_DIR/fwf-ghcache.sh" headroom 2>/dev/null)" || true   # exit 1 on UNKNOWN is intentional -- inspect $hr, don't let set -e treat it as doctor failing
  if [ "$hr" = "UNKNOWN" ] || [ -z "$hr" ]; then
    echo "  api budget : UNKNOWN — could not read gh api rate_limit (network/auth/rate-limited)"
    return 0
  fi
  remaining="$(printf '%s' "$hr" | grep -oE 'remaining=[0-9]+' | cut -d= -f2)"
  limit="$(printf '%s' "$hr" | grep -oE 'limit=[0-9]+' | cut -d= -f2)"
  reset="$(printf '%s' "$hr" | grep -oE 'reset=[0-9]+' | cut -d= -f2)"
  if [ -z "$remaining" ] || [ -z "$limit" ] || [ -z "$reset" ]; then
    echo "  api budget : UNKNOWN — headroom read was malformed"
    return 0
  fi
  now="$(date +%s)"; reset_in=$(( reset - now )); [ "$reset_in" -lt 0 ] && reset_in=0
  mret="$("$FWF_DIR/fwf-ghcache.sh" metrics 3600 2>/dev/null)"
  charged="$(printf '%s' "$mret" | grep -oE 'charged=[0-9]+' | cut -d= -f2)"
  charged="${charged:-0}"
  if [ "$charged" -gt 0 ] 2>/dev/null && [ "$remaining" -gt 0 ] 2>/dev/null; then
    eta="~$(( remaining / charged ))h at the current ${charged}/hr charged rate"
  else
    eta="no exhaustion risk at the current charged rate (${charged}/hr)"
  fi
  printf '  api budget : %s/%s remaining, resets in %ss — %s\n' "$remaining" "$limit" "$reset_in" "$eta"
}
# `fwf usage` (issue #95) reads message.usage.*/message.model off THIS process's
# own Claude Code transcript line shape — check it here so a Claude Code
# version that changes that shape is caught by 'fwf doctor', not by `fwf
# usage` silently under-reporting. Informational only (never fails doctor):
# unlike tmux/git/gh, a schema drift only affects the optional usage report,
# not whether the factory can launch.
_doctor_usage_schema() {
  local dir f sample
  dir="${FWF_CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}/$(_fwf_usage_slug "$PWD")"
  if [ ! -d "$dir" ]; then
    echo "  usage schema: skip (no Claude Code transcript dir yet for $PWD)"
    return 0
  fi
  command -v jq >/dev/null 2>&1 || { echo "  usage schema: skip (jq not installed)"; return 0; }
  # `|| true` on both: under this script's `set -euo pipefail`, `head -1`
  # closing the pipe early after its one line SIGPIPEs the writer (jq on a
  # large transcript, reliably; `ls` more rarely) -- pipefail then reports
  # the pipeline's exit as 141, which would abort doctor() entirely rather
  # than just skipping this one informational sub-check.
  f="$(ls -t "$dir"/*.jsonl 2>/dev/null | head -1)" || true
  [ -n "$f" ] || { echo "  usage schema: skip (no transcript files yet)"; return 0; }
  sample="$(jq -c 'select(.type=="assistant")' "$f" 2>/dev/null | head -1)" || true
  if [ -z "$sample" ]; then
    echo "  usage schema: no assistant-type line found yet in $(basename "$f") — nothing to check"
    return 0
  fi
  if printf '%s' "$sample" | jq -e \
       '.message.usage.input_tokens != null and .message.usage.output_tokens != null and .message.model != null' \
       >/dev/null 2>&1; then
    echo "  usage schema: ok (matches what 'fwf usage' expects)"
  else
    echo "  usage schema: WARNING — transcript line shape has drifted from what 'fwf usage' expects (message.usage.{input,output}_tokens / message.model) — see docs/proposals/70-token-usage-budget.md"
  fi
}
# issue #205 AC(h): warn (never refuse) when a profile's E2E_CMD looks like it
# hardcodes a port or data dir instead of reading the exported
# FWF_E2E_PORT/FWF_E2E_DATA_DIR (see lib.sh's fwf_e2e_lock_acquire and its
# canonical _fwf_e2e_cmd_hardcoded_warn, which this mirrors) -- a consumer
# that ignores the allocation silently re-serializes its own lane with every
# test still green, and this grep is the only signal fwf can give from its
# own side. Informational only, self-contained like _doctor_usage_schema
# above: doctor must still succeed with zero profiles configured, so this
# does NOT call resolve_profile() (which die()s on that case).
_doctor_e2e_cmd_check() {
  local names count prof pfile e2e_cmd warned=0
  if [ -n "${FWF_PROFILE:-}" ]; then
    prof="$FWF_PROFILE"
  else
    names="$(list_profiles)"
    count="$(printf '%s\n' "$names" | grep -c . || true)"
    if [ "$count" != "1" ]; then
      echo "  e2e lease : skip (no single profile to check -- pass --profile NAME)"
      return 0
    fi
    prof="$names"
  fi
  pfile="$(profiles_dir)/$prof.sh"
  [ -f "$pfile" ] || { echo "  e2e lease : skip (profile '$prof' not found)"; return 0; }
  # shellcheck source=/dev/null  # runtime-selected profile; path is not constant
  e2e_cmd="$(E2E_CMD=""; . "$pfile" >/dev/null 2>&1; printf '%s' "${E2E_CMD:-}")"
  if [ -z "$e2e_cmd" ]; then
    echo "  e2e lease : ok (profile '$prof' has no E2E_CMD)"
    return 0
  fi
  if printf '%s' "$e2e_cmd" | grep -Eq '[0-9]{4,5}' && ! printf '%s' "$e2e_cmd" | grep -q 'FWF_E2E_PORT'; then
    echo "  e2e lease : WARNING -- profile '$prof' E2E_CMD appears to hardcode a port instead of reading \$FWF_E2E_PORT (issue #205)"
    warned=1
  fi
  if printf '%s' "$e2e_cmd" | grep -Eq -- '(--data[= ]|/tmp/[A-Za-z0-9_./-]+)' && ! printf '%s' "$e2e_cmd" | grep -q 'FWF_E2E_DATA_DIR'; then
    echo "  e2e lease : WARNING -- profile '$prof' E2E_CMD appears to hardcode a data dir instead of reading \$FWF_E2E_DATA_DIR (issue #205)"
    warned=1
  fi
  [ "$warned" = 1 ] || echo "  e2e lease : ok (profile '$prof' E2E_CMD reads the exported allocation, or hardcodes neither)"
  return 0
}
# cwd -> Claude Code's project-dir slug: every '/' and '.' -> '-' (shared with
# fwf-usage-data.sh's identical helper; kept local here so doctor has no
# dependency on lib.sh/a resolved profile — it must run before either exists).
_fwf_usage_slug() {
  local s="$1"
  s="${s//\//-}"
  s="${s//./-}"
  printf '%s' "$s"
}
_doctor_one() { # $1 = binary  $2 = why
  if command -v "$1" >/dev/null 2>&1; then
    local v; v="$("$1" --version 2>/dev/null | head -1)"
    [ -n "$v" ] || v="$("$1" -V 2>/dev/null | head -1)"   # tmux only knows -V
    printf '  %-9s : %s\n' "$1" "$v"
    return 0
  fi
  printf '  %-9s : MISSING — %s\n' "$1" "$2"
  return 1
}

# --- init / start -----------------------------------------------------------
# Clone (or adopt a local path), detect, and scaffold a profile. Echoes the
# resolved profile name on the last line via the global PROFILE_NAME.
PROFILE_NAME=""
do_init() {
  local src="" name="" assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2;;
      --name=*) name="${1#*=}"; shift;;
      --yes|-y) assume_yes=1; shift;;
      -*) die "init: unknown flag '$1'";;
      *) if [ -z "$src" ]; then src="$1"; else die "init: unexpected argument '$1'"; fi; shift;;
    esac
  done
  [ -n "$src" ] || die "init: need a git URL or local path"
  [ -n "$name" ] || name="$(derive_name "$src")"
  [ -n "$name" ] || die "init: could not derive a name; pass --name"

  local existing; existing="$(profiles_dir)/$name.sh"
  if [ -e "$existing" ]; then
    die "profile '$name' already exists ($existing) — pass --name to use a different one, or edit it directly."
  fi

  local workspace repo defbr
  workspace="$FWF_WORKSPACE_BASE/$name"
  mkdir -p "$workspace"

  if is_url "$src"; then
    repo="$workspace/repo"
    if [ -d "$repo/.git" ]; then
      echo "fwf: repo already cloned at $repo — reusing it."
    else
      echo "fwf: cloning $src -> $repo"
      git clone "$src" "$repo"
    fi
  else
    repo="$(cd "$src" 2>/dev/null && pwd)" || die "init: local path not found: $src"
    [ -d "$repo/.git" ] || die "init: '$repo' is not a git repository"
    echo "fwf: using local repo $repo (worktrees under $workspace)"
  fi

  defbr="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || echo main)"

  echo "fwf: detecting toolchain in $repo ..."
  fwf_detect "$repo"
  echo
  echo "Detected for profile '$name' (default branch: $defbr):"
  fwf_detect_summary
  echo

  local out="$existing"
  if [ "$assume_yes" != 1 ] && [ -t 0 ]; then
    printf "Write profile and continue? [Y]es / [e]dit after writing / [a]bort: "
    local ans; read -r ans || ans=""
    case "$ans" in
      a|A|n|N) die "aborted by user (nothing written).";;
    esac
    fwf_write_profile "$out" "$name" "$repo" "$workspace" "$defbr"
    echo "fwf: wrote $out"
    case "$ans" in
      e|E) "${EDITOR:-vi}" "$out";;
    esac
  else
    fwf_write_profile "$out" "$name" "$repo" "$workspace" "$defbr"
    if [ "$assume_yes" = 1 ]; then echo "fwf: wrote $out"
    else echo "fwf: wrote $out (review it, then 'fwf --profile $name up')"; fi
  fi
  PROFILE_NAME="$name"
}

# --- dispatch ---------------------------------------------------------------
# Global --profile flag may precede the subcommand.
while [ $# -gt 0 ]; do
  case "${1:-}" in
    --profile) export FWF_PROFILE="$2"; shift 2;;
    --profile=*) export FWF_PROFILE="${1#*=}"; shift;;
    -h|--help|help) usage; exit 0;;
    -v|--version) cat "$FWF_DIR/VERSION" 2>/dev/null || echo "unknown"; exit 0;;
    --) shift; break;;
    -*) die "unknown global flag '$1' (did you mean a subcommand?)";;
    *) break;;
  esac
done

cmd="${1:-}"; [ $# -gt 0 ] && shift || true
# Runtime sizing/model flags are honored on the commands that launch or re-arm
# agents (and provision, which sizes the worktree set).
case "$cmd" in
  start|provision|up|respawn|resume|down|captain)
    parse_runtime_flags "$@"
    set -- ${RUNTIME_ARGS[@]+"${RUNTIME_ARGS[@]}"};;
esac
case "$cmd" in
  ""|help)   usage;;
  version)   cat "$FWF_DIR/VERSION" 2>/dev/null || echo "unknown";;
  doctor)    doctor;;
  upgrade)
    # Self-upgrade. Two install modes, two paths:
    #   git clone  -> fetch tags + ff-merge to the release tag, converging on
    #                 the same commit the tarball path installs (the clone IS
    #                 the install; refuses on a dirty tree)
    #   tarball    -> download the latest release NEXT TO the current dir + re-run
    #                 its install.sh (re-points the symlink; old dir left for rollback)
    # FWF_UPGRADE_REPO overrides the canonical repo (forks, tests).
    check_only=0
    for a in "$@"; do
      case "$a" in --check) check_only=1;; *) die "upgrade: unknown flag '$a'";; esac
    done
    command -v gh >/dev/null 2>&1 || die "upgrade: gh is required to query releases"
    current="$(cat "$FWF_DIR/VERSION" 2>/dev/null || echo unknown)"
    upgrade_repo="${FWF_UPGRADE_REPO:-tbaums/fun-with-friends}"
    latest="$(gh api "repos/$upgrade_repo/releases/latest" --jq .tag_name 2>/dev/null || true)"
    if [ -z "$latest" ]; then
      echo "fwf upgrade: could not query the latest release of $upgrade_repo (gh api failed — offline? unauthenticated?)." >&2
      if [ -d "$FWF_DIR/.git" ]; then
        echo "  your install is a git clone — 'git -C $FWF_DIR fetch --tags && git -C $FWF_DIR merge --ff-only <tag>' upgrades it to a specific release regardless." >&2
      elif [ -e "$FWF_DIR/.git" ]; then
        wt_main="$(fwf_worktree_main_root "$FWF_DIR" || true)"
        if [ -n "$wt_main" ]; then
          echo "  your install is a git worktree — run 'fwf upgrade' (or 'git -C $wt_main fetch --tags && git -C $wt_main merge --ff-only <tag>') from $wt_main instead." >&2
        else
          echo "  your install links to a git checkout via .git, but its target couldn't be resolved — find that checkout and run 'fwf upgrade' from there." >&2
        fi
      fi
      exit 1
    fi
    echo "fwf: installed $current · latest release ${latest#v}"
    if [ "v$current" = "$latest" ]; then echo "fwf: up to date."; exit 0; fi
    if [ "$check_only" = 1 ]; then echo "fwf: upgrade available — run 'fwf upgrade'."; exit 0; fi
    if [ -d "$FWF_DIR/.git" ]; then
      [ -z "$(git -C "$FWF_DIR" status --porcelain)" ] \
        || die "upgrade: the clone at $FWF_DIR has local changes — commit or stash them first."
      git -C "$FWF_DIR" fetch --tags || die "upgrade: git fetch --tags failed"
      git -C "$FWF_DIR" merge --ff-only "$latest" \
        || die "upgrade: git merge --ff-only to release $latest failed (local branch has diverged from the release tag?)"
      echo "fwf: upgraded $current -> $(cat "$FWF_DIR/VERSION") (git clone converged on release $latest in $FWF_DIR)."
    elif [ -e "$FWF_DIR/.git" ]; then
      # .git exists but isn't a plain directory — a linked worktree (the normal
      # case for every fwf-self swarm role) or something unresolvable. Either
      # way, upgrading THIS checkout in place is unsafe (feature branch / detached
      # HEAD / dirty), so refuse with guidance instead of guessing.
      wt_main="$(fwf_worktree_main_root "$FWF_DIR" || true)"
      if [ -n "$wt_main" ]; then
        die "upgrade: $FWF_DIR is a git worktree, not the main checkout — upgrading it in place would be unsafe.
  Run 'fwf upgrade' from $wt_main instead (equivalent: git -C $wt_main fetch --tags && git -C $wt_main merge --ff-only <tag>)."
      else
        die "upgrade: $FWF_DIR/.git exists but isn't a plain git directory, and its target couldn't be resolved — refusing to guess.
  Find the git checkout this install links to and run 'fwf upgrade' from there."
      fi
    else
      base="$(dirname "$FWF_DIR")"
      newdir="$base/fwf-${latest#v}"
      [ -e "$newdir" ] && die "upgrade: $newdir already exists — remove it or upgrade by hand."
      tmpd="$(mktemp -d "${TMPDIR:-/tmp}/fwf-upgrade.XXXXXX")"
      gh release download "$latest" -R "$upgrade_repo" -p '*.tar.gz' -D "$tmpd" \
        || { rm -rf "$tmpd"; die "upgrade: release download failed"; }
      tar -C "$base" -xzf "$tmpd"/*.tar.gz
      rm -rf "$tmpd"
      [ -x "$newdir/install.sh" ] || die "upgrade: extracted $newdir is missing install.sh — aborting before re-linking"
      "$newdir/install.sh" ${FWF_UPGRADE_BIN:+"$FWF_UPGRADE_BIN"}
      echo "fwf: installed ${latest#v} at $newdir (symlink re-pointed)."
      echo "fwf: the old install at $FWF_DIR was left in place — remove it once you're happy."
    fi
    echo "note: a RUNNING factory keeps its old prompts until panes restart — 'fwf resume' (or 'fwf respawn <role>') re-arms them on the new version."
    ;;
  profiles)  list_profiles;;
  templates)
    for d in "$FWF_DIR"/templates/*/; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"
      case "$name" in _*) continue;; esac   # _local-issues etc: addenda, not selectable templates
      desc=""
      [ -f "$d/template.sh" ] && desc="$(sed -n 's/^# fwf template: //p' "$d/template.sh" | head -1)"
      printf '%-12s %s\n' "$name" "$desc"
    done;;
  init)      do_init "$@";;
  suggest)   exec "$FWF_DIR/fwf-suggest.sh" "$@";;
  eval)      exec "$FWF_DIR/eval/run.sh" "$@";;
  start)
    # peel off init-only vs run flags: --build belongs to provision
    build_flag=""; init_args=()
    for a in "$@"; do
      if [ "$a" = "--build" ]; then build_flag="--build"; else init_args+=("$a"); fi
    done
    # bash 3.2 + set -u: expanding an empty array errors, so guard it.
    do_init ${init_args[@]+"${init_args[@]}"}
    echo
    echo "fwf: provisioning worktrees for '$PROFILE_NAME' ..."
    FWF_PROFILE="$PROFILE_NAME" "$FWF_DIR/fwf-provision.sh" $build_flag
    echo "fwf: launching the grid ..."
    FWF_PROFILE="$PROFILE_NAME" "$FWF_DIR/fwf-up.sh"
    ;;
  issues)    engine fwf-issues.sh "$@";;
  dash)      engine fwf-dash.sh "$@";;
  pr-review-state) engine fwf-pr-review-state.sh "$@";;
  pr-reviewer) engine fwf-pr-reviewer.sh "$@";;
  pr-assign-reviewer) engine fwf-pr-assign-reviewer.sh "$@";;
  branch-policy) engine fwf-branch-policy.sh "$@";;
  pr-checks-honored) engine fwf-pr-checks-honored.sh "$@";;
  pr-context) engine fwf-pr-context.sh "$@";;
  merge)     engine fwf-merge.sh "$@";;
  backfill-context) engine fwf-backfill-context.sh "$@";;
  flag-captain) engine fwf-flag-captain.sh "$@";;
  usage)     engine fwf-usage.sh "$@";;
  supervise) engine fwf-supervise.sh "$@";;
  gate)      engine fwf-gate.sh "$@";;
  gate-tip)  engine fwf-gate-tip.sh "$@";;
  gate-promote) engine fwf-gate-promote.sh "$@";;
  gate-revoke) engine fwf-gate-revoke.sh "$@";;
  gate-rust-scope) engine fwf-gate-rust-scope.sh "$@";;
  authz)     engine fwf-authz.sh "$@";;
  claim)     engine fwf-claim.sh "$@";;
  auth)      engine fwf-auth.sh "$@";;
  budget-check) engine fwf-budget-check.sh "$@";;
  reconcile) engine fwf-reconcile.sh "$@";;
  worktree-refresh) engine fwf-worktree-refresh.sh "$@";;
  reconcile-guard) engine fwf-reconcile-guard.sh "$@";;
  shell)
    # First containerization slice (#3): one image with the whole pane
    # toolchain (bash/tmux/git/gh/claude); auth mounted from the host, never
    # baked in. Proves claude+tmux+auth work contained; later slices (floor
    # containers, e2e isolation) reuse this image. See docs/containers.md.
    command -v docker >/dev/null 2>&1 || die "shell: docker is required (install Docker Desktop or colima)"
    docker info >/dev/null 2>&1 || die "shell: the docker daemon is not running"
    build_args=()
    [ "${1:-}" = "--rebuild" ] && build_args=(--no-cache)
    docker build ${build_args[@]+"${build_args[@]}"} -t fwf-toolchain "$FWF_DIR/containers" \
      || die "shell: image build failed"
    vols=(-v "$FWF_DIR:/opt/fwf")
    [ -f "$HOME/.gitconfig" ] && vols+=(-v "$HOME/.gitconfig:/home/friend/.gitconfig:ro")
    envs=()
    # gh on macOS keeps its token in the Keychain, so mounting ~/.config/gh
    # carries no auth — inject the token itself (gh honors GH_TOKEN anywhere).
    ghtok="$(gh auth token 2>/dev/null || true)"
    [ -n "$ghtok" ] && envs+=(-e "GH_TOKEN=$ghtok")
    # claude auth: COPIES of the two credential files go into a throwaway 0700
    # dir, mounted file-by-file (Docker Desktop cannot nest a file mount inside
    # a bind-mounted dir, so we never mount ~/.claude itself; token refreshes
    # inside the sandbox are deliberately discarded). Source of the OAuth blob:
    # ~/.claude/.credentials.json on Linux hosts, the Keychain on macOS.
    mkdir -p "$FWF_RUN"
    authdir="$(mktemp -d "$FWF_RUN/shell-auth.XXXXXX")"
    chmod 700 "$authdir"
    if [ -f "$HOME/.claude/.credentials.json" ]; then
      cp "$HOME/.claude/.credentials.json" "$authdir/credentials.json"
    elif command -v security >/dev/null 2>&1; then
      blob="$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null || true)"
      [ -n "$blob" ] && ( umask 077; printf '%s' "$blob" > "$authdir/credentials.json" )
    fi
    [ -f "$authdir/credentials.json" ] \
      && vols+=(-v "$authdir/credentials.json:/home/friend/.claude/.credentials.json") \
      || echo "fwf: no claude credentials found on the host — run 'claude /login' inside the shell." >&2
    [ -f "$HOME/.claude.json" ] && cp "$HOME/.claude.json" "$authdir/claude.json" \
      && vols+=(-v "$authdir/claude.json:/home/friend/.claude.json")
    rc=0
    docker run --rm -it "${vols[@]}" ${envs[@]+"${envs[@]}"} -w /opt/fwf fwf-toolchain bash || rc=$?
    rm -rf "$authdir"
    exit "$rc";;
  provision) engine fwf-provision.sh "$@";;
  up)        engine fwf-up.sh "$@";;
  respawn)   engine fwf-respawn.sh "$@";;
  tick)
    # issue #133: a looping role's step-0 heartbeat, upgraded to a monotonic
    # per-role loop-tick counter. Deliberately tiny (no engine indirection) —
    # every agent runs it every cycle. Echoes the new count.
    # issue #182: resolve via resolve_profile_liveness(), NOT resolve_profile()
    # — tick has no --profile flag, so any ambient $FWF_PROFILE it sees can
    # only be stale leftover env, never a deliberate pin; trusting it blindly
    # can misroute the heartbeat and make a live role look dead to
    # health-gate/respawn.
    FWF_PROFILE="$(resolve_profile_liveness)"
    source "$FWF_DIR/lib.sh"
    role="${1:-}"; [ -n "$role" ] || die "tick: usage: fwf tick <role>"
    fwf_tick_bump "$role";;
  stub-sweep)
    # issue #133: auto-close claim-only draft PRs (zero changed files) that a
    # dead loop opened and abandoned. Idempotent; safe to run from a caretaker.
    FWF_PROFILE="$(resolve_profile)"
    source "$FWF_DIR/lib.sh"
    fwf_stub_sweep "$@";;
  stop)      engine fwf-stop.sh "$@";;
  resume)    engine fwf-resume.sh "$@";;
  down)      engine fwf-down.sh "$@";;
  attach)
    FWF_PROFILE="$(resolve_profile)"
    source "$FWF_DIR/lib.sh"
    case "${1:-coord}" in
      coord|coordination) target="$COORD_SESSION";;
      build|impl|implementation) target="$BUILD_SESSION";;
      *) die "attach: unknown target '${1:-}' (use 'coord' or 'build')";;
    esac
    exec tmux attach -t "$target";;
  captain)
    print_only=0
    for a in "$@"; do
      case "$a" in --print) print_only=1;; *) die "captain: unknown flag '$a'";; esac
    done
    FWF_PROFILE="$(resolve_profile)"
    source "$FWF_DIR/lib.sh"
    rendered="$(fwf_render "$(fwf_tmpl_path captain)" "")"
    if [ "$print_only" = 1 ]; then
      printf '%s\n' "$rendered"
    else
      copier=""
      if   command -v pbcopy  >/dev/null 2>&1; then copier="pbcopy"
      elif command -v wl-copy >/dev/null 2>&1; then copier="wl-copy"
      elif command -v xclip   >/dev/null 2>&1; then copier="xclip -selection clipboard"
      fi
      if [ -n "$copier" ]; then
        printf '%s' "$rendered" | $copier
        echo "fwf: CAPTAIN prompt copied to clipboard."
      else
        echo "fwf: no clipboard tool (pbcopy/wl-copy/xclip) found — printing instead." >&2
        printf '%s\n' "$rendered"
      fi
      echo "The captain normally runs as a pane (fwf up → coordination session)."
      echo "To drive it as a standalone session instead, start Claude in the repo and paste this:"
      echo "  cd $FWF_REPO && $CLAUDE_CMD"
    fi;;
  *) die "unknown command '$cmd' (try 'fwf help')";;
esac
