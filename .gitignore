# Release artifacts
/dist/

# User-generated profiles (written by `fwf init`); only the example template is tracked.
profiles/*.sh
!profiles/example.sh

# macOS / editor cruft
.DS_Store
*.swp
*~

# Per-worktree profile marker (issue #182), written by fwf-provision.sh at
# each worktree/scratch dir's root; local runtime state, never committed.
.fwf-profile
